<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_plcs_layout" model="ir.ui.view">
        <field name="name">res.company.form.plcs.layout</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Briefpapier (PLCS)" name="plcs_layout">
                    <p class="text-muted">
                        Diese Angaben stehen in der Fußzeile aller Belege (Dokumentlayout „PLCS“).
                        Anschrift, Telefon, E-Mail und USt-IdNr. kommen aus dem Reiter „Allgemein“.
                    </p>
                    <group>
                        <group string="Fußzeile">
                            <field name="plcs_legal_name" placeholder="Pharma-Logistik-Consulting-Services GmbH"/>
                            <field name="plcs_managing_director"/>
                            <field name="plcs_register_court" placeholder="Amtsgericht Saarbrücken"/>
                            <field name="plcs_registry" placeholder="HRB 103353"/>
                            <field name="plcs_tax_number"/>
                            <field name="plcs_bank_id" context="{'default_partner_id': partner_id}"/>
                        </group>
                        <group string="Hinweis auf allen Belegen">
                            <field name="plcs_legal_note" nolabel="1" colspan="2"
                                   placeholder="z. B. Wir verfügen über die Großhandelserlaubnis gemäß §52a AMG … (Wortlaut von PLCS)"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
