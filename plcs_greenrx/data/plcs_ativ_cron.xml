<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Alle 12 Stunden Änderungen bei ATIV planen. Zeiten in UTC (Odoo-Server); siehe docs/ATIV_SCHNITTSTELLE.md -->
    <record id="cron_ativ_schedule" model="ir.cron">
        <field name="name">GreenRX: ATIV-Gutschriften abgleichen (alle 12 Stunden)</field>
        <field name="model_id" ref="model_plcs_greenrx_connector"/>
        <field name="state">code</field>
        <field name="code">model._cron_ativ_schedule()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=10, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
    <!-- Arbeitet die Warteschlange ab. Wird bei Bedarf sofort angestoßen (Knopf, Webhook). -->
    <record id="cron_ativ_worker" model="ir.cron">
        <field name="name">GreenRX: ATIV-Warteschlange abarbeiten</field>
        <field name="model_id" ref="model_plcs_greenrx_connector"/>
        <field name="state">code</field>
        <field name="code">model._cron_ativ_worker()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
