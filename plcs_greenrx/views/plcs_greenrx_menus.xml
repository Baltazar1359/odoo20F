<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_grx_root" name="GreenRX" sequence="30"
              web_icon="plcs_greenrx,static/description/icon.png"
              groups="group_grx_user,stock.group_stock_user"/>

    <menuitem id="menu_grx_app" name="Wareneingang scannen" parent="menu_grx_root" sequence="1"
              action="action_grx_app" groups="group_grx_user"/>
    <menuitem id="menu_grx_vp" name="VP-Freigabe" parent="menu_grx_root" sequence="2"
              action="action_grx_vp" groups="group_grx_vp"/>

    <menuitem id="menu_grx_data" name="Übersicht" parent="menu_grx_root" sequence="10"/>
    <record id="action_grx_stock" model="ir.actions.server">
        <field name="name">Bestand GreenRX</field>
        <field name="model_id" ref="model_plcs_greenrx_box"/>
        <field name="state">code</field>
        <field name="code">action = model.action_grx_stock()</field>
        <field name="group_ids" eval="[(4, ref('plcs_greenrx.group_grx_user')), (4, ref('plcs_greenrx.group_grx_vp')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
    <menuitem id="menu_grx_stock" name="Bestand GreenRX" parent="menu_grx_data" sequence="0" action="action_grx_stock"/>
    <menuitem id="menu_grx_tickets" name="Retourenvorgänge" parent="menu_grx_data" sequence="1" action="action_grx_tickets"/>
    <menuitem id="menu_grx_boxes" name="Box-Erfassungen" parent="menu_grx_data" sequence="2" action="action_grx_boxes"/>
    <menuitem id="menu_grx_serials" name="Seriennummern" parent="menu_grx_data" sequence="3" action="action_grx_serials"/>
    <menuitem id="menu_grx_scans" name="Scan-Protokoll" parent="menu_grx_data" sequence="4" action="action_grx_scans"/>
    <menuitem id="menu_grx_packages" name="Boxen GX" parent="menu_grx_data" sequence="5" action="action_grx_packages"/>

    <menuitem id="menu_grx_config" name="Konfiguration" parent="menu_grx_root" sequence="90" groups="stock.group_stock_manager"/>
    <menuitem id="menu_grx_connector" name="Schnittstelle GreenRX-ERP" parent="menu_grx_config" sequence="1" action="action_grx_connector"/>
</odoo>
