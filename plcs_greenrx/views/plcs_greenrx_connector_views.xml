<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_grx_connector_list" model="ir.ui.view">
        <field name="name">plcs.greenrx.connector.list</field>
        <field name="model">plcs.greenrx.connector</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mode"/>
                <field name="url"/>
                <field name="sync_enabled"/>
                <field name="last_success_date"/>
                <field name="run_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_grx_connector_form" model="ir.ui.view">
        <field name="name">plcs.greenrx.connector.form</field>
        <field name="model">plcs.greenrx.connector</field>
        <field name="arch" type="xml">
            <form string="Schnittstelle GreenRX-ERP">
                <header>
                    <button name="action_test" type="object" string="Verbindung testen" class="btn-secondary"/>
                    <button name="action_ativ_sync" type="object" string="ATIV-Daten synchronisieren" class="btn-primary"
                            invisible="mode != 'ativ'"/>
                    <button name="action_ativ_full" type="object" string="Vollabgleich" class="btn-secondary"
                            invisible="mode != 'ativ'"
                            confirm="Alle Gutschriften des Filters erneut prüfen? Das läuft im Hintergrund und kann einige Minuten dauern."/>
                    <button name="action_ativ_products_sync" type="object" string="Artikel synchronisieren"
                            class="btn-secondary" invisible="mode != 'ativ' or not ativ_product_sync"/>
                    <button name="action_ativ_retry" type="object" string="Fehler wiederholen" class="btn-secondary"
                            invisible="mode != 'ativ' or not queue_failed"/>
                    <button name="action_ativ_disable" type="object" string="Integration ausschalten" class="btn-secondary"
                            invisible="mode != 'ativ' or (not sync_enabled and not webhook_enabled and not ativ_product_sync)"/>
                    <button name="action_sync" type="object" string="Jetzt abrufen" class="btn-primary"
                            invisible="mode != 'legacy'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="mode != 'ativ'">
                        <button name="action_open_credit_notes" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="credit_note_count" widget="statinfo" string="Gutschriften"/>
                        </button>
                        <button name="action_open_ativ_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="ativ_product_count" widget="statinfo" string="Artikel aus ATIV"/>
                        </button>
                        <button name="action_open_runs" type="object" class="oe_stat_button" icon="fa-history" string="Läufe"/>
                        <button name="action_open_queue" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="queue_pending" widget="statinfo" string="Offene Schritte"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Zugang">
                            <field name="mode"/>
                            <field name="url" placeholder="https://ativ-service.odoo.com"/>
                            <field name="db"/>
                            <field name="login"/>
                            <field name="api_key" password="True"/>
                            <field name="protocol" invisible="mode != 'ativ'"/>
                            <field name="timeout" invisible="mode != 'ativ'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Stand" invisible="mode != 'ativ'">
                            <field name="sync_enabled" string="Automatisch alle 12 Stunden"/>
                            <field name="last_success_date"/>
                            <field name="current_run_id"/>
                            <field name="run_state" widget="badge" decoration-success="run_state == 'done'"
                                   decoration-info="run_state == 'running'" decoration-warning="run_state == 'partial'"
                                   decoration-danger="run_state == 'failed'"/>
                            <field name="queue_failed" decoration-danger="queue_failed &gt; 0"/>
                            <field name="ativ_cursor"/>
                            <field name="last_result"/>
                            <field name="tracking_readable"/>
                        </group>
                        <group string="Letzter Abruf" invisible="mode != 'legacy'">
                            <field name="sync_enabled"/>
                            <field name="last_sync"/>
                            <field name="last_result"/>
                        </group>
                    </group>
                    <notebook invisible="mode != 'ativ'">
                        <page string="Umfang und Status" name="ativ_scope">
                            <group>
                                <group string="Welche Daten">
                                    <field name="source_code" placeholder="leer = Datenbankname"/>
                                    <field name="ativ_base_domain"/>
                                    <field name="doc_copy"/>
                                    <field name="ativ_create_products"/>
                                    <field name="batch_size"/>
                                    <field name="max_attempts"/>
                                </group>
                                <group string="Wann gilt ein Paket als erwartet?">
                                    <field name="stages_expected"/>
                                    <field name="stages_announced"/>
                                    <field name="stages_closed"/>
                                    <field name="stages_cancel"/>
                                    <field name="expected_since"/>
                                </group>
                            </group>
                        </page>
                        <page string="Artikelstamm" name="ativ_products">
                            <group>
                                <group string="Artikel aus ATIV">
                                    <field name="ativ_product_sync"/>
                                    <field name="ativ_product_domain" invisible="not ativ_product_sync"/>
                                    <field name="ativ_product_cursor" invisible="not ativ_product_sync"/>
                                    <field name="ativ_product_run_id" invisible="not ativ_product_sync"/>
                                    <button name="action_ativ_products_full" type="object" string="Alle Artikel neu abgleichen"
                                            class="btn-secondary" colspan="2" invisible="not ativ_product_sync"
                                            confirm="Alle ATIV-Artikel des Filters erneut prüfen? Das läuft im Hintergrund."/>
                                </group>
                                <group>
                                    <div class="text-muted" colspan="2">
                                        Übernimmt Bezeichnung, PZN, GTIN, Lagerbedingungen und Produktbild.
                                        Neue Artikel werden vollständig angelegt. Bei vorhandenen Artikeln füllt PLCS nur
                                        leere Felder; Bezeichnung und Lagertemperatur bleiben. Abweichungen stehen am
                                        Artikel unter „Abweichung zu ATIV“. Läuft mit dem 12-Stunden-Zeitplan, per Knopf
                                        und – mit Webhook-Regel auf „Produkt“ bei ATIV – sofort.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Webhook" name="ativ_webhook">
                            <group>
                                <group>
                                    <field name="webhook_enabled"/>
                                    <field name="webhook_url"/>
                                    <button name="action_generate_webhook_token" type="object" string="Neuen Webhook-Schlüssel erzeugen"
                                            class="btn-secondary" colspan="2"
                                            confirm="Ein vorhandener Schlüssel wird ungültig. Die neue Adresse muss in ATIV eingetragen werden. Weiter?"/>
                                </group>
                                <group>
                                    <div class="text-muted" colspan="2">
                                        Der Webhook meldet PLCS nur, dass sich bei ATIV etwas geändert hat. Die Daten liest PLCS danach
                                        über die API. Ohne Webhook kommen Änderungen mit dem nächsten 12-Stunden-Lauf oder per Knopf.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group string="Feldzuordnung im GreenRX-ERP (alt)" invisible="mode != 'legacy'">
                        <div class="alert alert-info" role="status" colspan="2">
                            Alte Feldzuordnung (Helpdesk-Ticket mit Studio-Feldern, Stand 06/2025).
                            Für ATIV die Art „ATIV-Gutschriften“ verwenden.
                        </div>
                        <group>
                            <field name="remote_model"/>
                            <field name="remote_domain"/>
                            <field name="f_name"/>
                            <field name="f_reference"/>
                            <field name="f_complaint"/>
                            <field name="f_batch"/>
                            <field name="f_credit_note"/>
                            <field name="f_partner"/>
                            <field name="f_customer_number"/>
                        </group>
                        <group>
                            <field name="f_product"/>
                            <field name="f_qty"/>
                            <field name="product_code_fields"/>
                            <field name="line_model"/>
                            <field name="line_link_field"/>
                            <field name="line_product_field"/>
                            <field name="line_qty_field"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_grx_connector" model="ir.actions.act_window">
        <field name="name">Schnittstelle GreenRX-ERP</field>
        <field name="res_model">plcs.greenrx.connector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
