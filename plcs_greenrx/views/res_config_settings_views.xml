<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_grx" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.greenrx</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="GreenRX" name="greenrx_setting_container">
                    <setting id="grx_rules" string="Regeln im Wareneingang" company_dependent="1"
                             help="Mindest-Restlaufzeit und Umgang mit Codes ohne Trennzeichen">
                        <div class="mt8">
                            <label for="plcs_grx_min_shelf_months" class="o_light_label"/>
                            <field name="plcs_grx_min_shelf_months" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <field name="plcs_grx_allow_heuristic"/>
                            <label for="plcs_grx_allow_heuristic" class="o_light_label"/>
                        </div>
                        <div class="mt8">
                            <field name="plcs_grx_create_from_slip"/>
                            <label for="plcs_grx_create_from_slip" class="o_light_label"/>
                        </div>
                    </setting>
                    <setting id="grx_boxes" string="Boxen" company_dependent="1" help="Box-Nummern für den GreenRX-Eingang">
                        <div class="mt8">
                            <label for="plcs_grx_box_prefix" class="o_light_label"/>
                            <field name="plcs_grx_box_prefix" class="oe_inline"/>
                        </div>
                        <div class="mt8">
                            <label for="plcs_grx_box_max" class="o_light_label"/>
                            <field name="plcs_grx_box_max" class="oe_inline"/>
                        </div>
                        <button name="action_plcs_grx_create_boxes" type="object" string="Fehlende Boxen anlegen" class="btn-link" icon="oi-arrow-right"/>
                    </setting>
                    <setting id="grx_locations" string="Lagerorte und Vorgänge" company_dependent="1">
                        <div class="mt8">
                            <label for="plcs_grx_quarantine_location_id" class="o_light_label"/>
                            <field name="plcs_grx_quarantine_location_id"/>
                        </div>
                        <div class="mt8">
                            <label for="plcs_grx_stock_location_id" class="o_light_label"/>
                            <field name="plcs_grx_stock_location_id"/>
                        </div>
                        <div class="mt8">
                            <label for="plcs_grx_blocked_location_id" class="o_light_label"/>
                            <field name="plcs_grx_blocked_location_id"/>
                        </div>
                        <div class="mt8">
                            <label for="plcs_grx_receipt_type_id" class="o_light_label"/>
                            <field name="plcs_grx_receipt_type_id"/>
                        </div>
                        <div class="mt8">
                            <label for="plcs_grx_release_type_id" class="o_light_label"/>
                            <field name="plcs_grx_release_type_id"/>
                        </div>
                        <div class="mt8">
                            <label for="plcs_grx_block_type_id" class="o_light_label"/>
                            <field name="plcs_grx_block_type_id"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
