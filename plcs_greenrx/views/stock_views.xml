<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lot_form_grx" model="ir.ui.view">
        <field name="name">stock.lot.form.greenrx</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <div invisible="not plcs_is_grx_serial" class="text-muted">
                    GreenRX-Packung: Seriennummer · Charge <field name="plcs_batch" class="fw-bold"/>
                    · <field name="plcs_grx_box_id"/>
                    <span invisible="not plcs_grx_manual" class="badge text-bg-warning ms-1">von Hand eingegeben</span>
                    <span invisible="not plcs_grx_archived" class="badge text-bg-secondary ms-1">Belegung archiviert</span>
                    <div>Verbleib: <field name="plcs_grx_whereabouts" class="d-inline"/></div>
                    <button name="action_plcs_grx_open_document" type="object" string="Formblatt öffnen"
                            class="btn btn-link p-0" icon="picture_as_pdf" groups="plcs_greenrx.group_grx_user"/>
                    <field name="plcs_grx_archived" invisible="1"/>
                    <field name="plcs_is_grx_serial" invisible="1"/>
                    <field name="plcs_grx_manual" invisible="1"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_lot_list_grx" model="ir.ui.view">
        <field name="name">stock.lot.list.greenrx</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="plcs_batch" optional="show"/>
                <field name="expiration_date" optional="show"/>
                <field name="plcs_grx_box_id" optional="show"/>
                <field name="plcs_grx_ticket_id" optional="hide"/>
                <field name="plcs_grx_manual" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_lot_search_grx" model="ir.ui.view">
        <field name="name">stock.lot.search.greenrx</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="plcs_batch"/>
                <field name="plcs_grx_box_id"/>
            </field>
        </field>
    </record>

    <record id="view_package_form_grx" model="ir.ui.view">
        <field name="name">stock.package.form.greenrx</field>
        <field name="model">stock.package</field>
        <field name="inherit_id" ref="stock.stock_package_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="GreenRX" invisible="not plcs_is_grx_box">
                    <field name="plcs_is_grx_box"/>
                    <field name="plcs_grx_is_empty"/>
                    <field name="plcs_grx_current_box_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_grx_packages" model="ir.actions.act_window">
        <field name="name">GreenRX-Boxen</field>
        <field name="res_model">stock.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('plcs_is_grx_box', '=', True)]</field>
        <field name="context">{'create': 0}</field>
    </record>

    <record id="product_template_form_grx" model="ir.ui.view">
        <field name="name">product.template.form.greenrx</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="plcs_pzn"/>
                <field name="plcs_storage_temp"/>
                <field name="plcs_ativ_key" invisible="1"/>
                <field name="plcs_ativ_name" invisible="not plcs_ativ_key"/>
                <field name="plcs_ativ_storage" invisible="not plcs_ativ_key"/>
                <field name="plcs_ativ_diff" invisible="not plcs_ativ_diff" decoration-warning="plcs_ativ_diff"/>
                <field name="plcs_ativ_sync_date" invisible="not plcs_ativ_key"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_grx" model="ir.ui.view">
        <field name="name">product.template.search.greenrx</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="before">
                <filter name="plcs_from_ativ" string="Aus ATIV" domain="[('plcs_ativ_key', '!=', False)]"/>
                <filter name="plcs_ativ_differs" string="Weicht von ATIV ab" domain="[('plcs_ativ_diff', '!=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Bestand: Charge und Verfall je Packung -->
    <record id="view_stock_quant_tree_grx" model="ir.ui.view">
        <field name="name">stock.quant.list.greenrx</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="plcs_batch" optional="show"/>
                <field name="expiration_date" widget="date" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_grx_stock_quant_list" model="ir.ui.view">
        <field name="name">stock.quant.list.greenrx.bestand</field>
        <field name="model">stock.quant</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Bestand GreenRX" create="0" delete="0" edit="0" export_xlsx="1"
                  decoration-danger="expiration_date and expiration_date &lt; current_date">
                <field name="location_id" string="Lagerort"/>
                <field name="package_id" string="Box"/>
                <field name="product_id" string="Artikel"/>
                <field name="lot_id" string="Seriennummer"/>
                <field name="plcs_batch"/>
                <field name="expiration_date" string="Verfall" widget="date"/>
                <field name="plcs_grx_ampel" widget="badge" optional="show"
                       decoration-success="plcs_grx_ampel == 'gruen'" decoration-warning="plcs_grx_ampel == 'gelb'"
                       decoration-danger="plcs_grx_ampel == 'rot'"/>
                <field name="quantity" string="Menge" sum="Summe"/>
                <field name="uom_id" groups="uom.group_uom" optional="hide"/>
                <button name="action_plcs_grx_open_document" type="object" string="Formblatt" icon="picture_as_pdf"
                        groups="plcs_greenrx.group_grx_user"/>
            </list>
        </field>
    </record>

    <record id="quant_search_view_grx" model="ir.ui.view">
        <field name="name">stock.quant.search.greenrx</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="plcs_batch"/>
            </field>
            <filter name="package" position="after">
                <filter string="Charge" name="grx_batch" context="{'group_by': 'plcs_batch'}"/>
                <filter string="Verfall (Monat)" name="grx_expiry" context="{'group_by': 'expiration_date:month'}"/>
            </filter>
        </field>
    </record>

    <!-- Wareneingang/Bewegungen: Charge neben der Seriennummer -->
    <record id="view_stock_move_line_operation_tree_grx" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.greenrx</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="plcs_batch" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_tree_grx" model="ir.ui.view">
        <field name="name">stock.move.line.list.greenrx</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="plcs_batch" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
