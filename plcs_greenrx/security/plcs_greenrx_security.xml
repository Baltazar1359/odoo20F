<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_greenrx" model="res.groups.privilege">
        <field name="name">GreenRX</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_grx_user" model="res.groups">
        <field name="name">Lager (Erfassung)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_greenrx"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Darf GreenRX-Pakete erfassen: Box scannen, Packungen scannen, Vorprüfung, Drucken.</field>
    </record>

    <record id="group_grx_vp" model="res.groups">
        <field name="name">VP-Freigabe</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_greenrx"/>
        <field name="implied_ids" eval="[(4, ref('group_grx_user'))]"/>
        <field name="comment">Verantwortliche Person: gibt Boxen frei oder sperrt sie (4-Augen-Prinzip: nicht die eigenen).</field>
    </record>

    <!-- Administrator bekommt beide GreenRX-Rollen, damit Wareneingang und VP-Freigabe
         auch in neuen Datenbanken (z. B. Odoo.sh-Testbuilds) sofort im Menü stehen -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_grx_vp'))]"/>
    </record>

    <!-- Lose/Seriennummern, Pakete und Lagerorte für alle internen Benutzer sichtbar -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('stock.group_production_lot')),
            (4, ref('stock.group_tracking_lot')),
            (4, ref('stock.group_stock_multi_locations')),
        ]"/>
    </record>
</odoo>
