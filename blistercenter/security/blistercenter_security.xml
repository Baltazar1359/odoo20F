<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_blistercenter" model="res.groups.privilege">
        <field name="name">Blistercenter</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_bc_user" model="res.groups">
        <field name="name">Benutzer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_blistercenter"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_partner_manager')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('stock.group_production_lot')),
        ]"/>
        <field name="comment">Tägliche Arbeit: Kundenbestellungen, Sammelbestellungen, Lager und Versand. Darf Chargen sperren, aber nicht entsperren.</field>
    </record>

    <record id="group_bc_approver" model="res.groups">
        <field name="name">Freigabe</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_blistercenter"/>
        <field name="implied_ids" eval="[(4, ref('group_bc_user'))]"/>
        <field name="comment">Zusätzlich: Shopfreischaltung, Zahlungsmodell, Zahlungssperre, Preisliste und Zahlungsbedingung von Blistercentern; Chargen entsperren.</field>
    </record>

    <record id="group_bc_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_blistercenter"/>
        <field name="implied_ids" eval="[
            (4, ref('group_bc_approver')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('purchase.group_purchase_manager')),
        ]"/>
        <field name="comment">Zusätzlich: Einstellungen und Prozessregeln der App Blistercenter, Preislisten.</field>
    </record>

    <!-- Arbeitsbereiche (1.3.0): steuern nur, welche Menüs und Aufgaben jemand sieht.
         Die Rechte kommen weiter aus „Benutzer“ (jeder Bereich schließt ihn ein).
         Freigabe und Administrator sehen alles. Je Bereich eine eigene Zeile im Benutzerformular. -->
    <record id="res_groups_privilege_bc_sales" model="res.groups.privilege">
        <field name="name">Blistercenter: Bestellannahme</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">101</field>
    </record>
    <record id="group_bc_sales" model="res.groups">
        <field name="name">Ja</field>
        <field name="privilege_id" ref="res_groups_privilege_bc_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_bc_user'))]"/>
        <field name="comment">Menü und Aufgaben: Telefonbestellung, Kundenbestellungen, Kunden.</field>
    </record>

    <record id="res_groups_privilege_bc_purchase" model="res.groups.privilege">
        <field name="name">Blistercenter: Einkauf</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">102</field>
    </record>
    <record id="group_bc_purchase" model="res.groups">
        <field name="name">Ja</field>
        <field name="privilege_id" ref="res_groups_privilege_bc_purchase"/>
        <field name="implied_ids" eval="[(4, ref('group_bc_user'))]"/>
        <field name="comment">Menü und Aufgaben: Zu bestellen, Sammelbestellungen, Hersteller.</field>
    </record>

    <record id="res_groups_privilege_bc_stock" model="res.groups.privilege">
        <field name="name">Blistercenter: Lager</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">103</field>
    </record>
    <record id="group_bc_stock" model="res.groups">
        <field name="name">Ja</field>
        <field name="privilege_id" ref="res_groups_privilege_bc_stock"/>
        <field name="implied_ids" eval="[(4, ref('group_bc_user'))]"/>
        <field name="comment">Menü und Aufgaben: Wareneingang, Kommissionieren, Endkontrolle, Chargen.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_bc_manager'))]"/>
    </record>
</odoo>
