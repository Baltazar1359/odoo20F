<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_blistercenter" model="res.groups.privilege">
        <field name="name">Blistercenter</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_bc_user" model="res.groups">
        <field name="name">Benutzer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_blistercenter"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_partner_manager')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('stock.group_production_lot')),
        ]"/>
        <field name="comment">Tägliche Arbeit: Kundenbestellungen, Sammelbestellungen, Lager und Versand. Darf Chargen sperren, aber nicht entsperren.</field>
    </record>

    <record id="group_bc_approver" model="res.groups">
        <field name="name">Freigabe</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_blistercenter"/>
        <field name="implied_ids" eval="[(4, ref('group_bc_user'))]"/>
        <field name="comment">Zusätzlich: Shopfreischaltung, Zahlungsmodell, Zahlungssperre, Preisliste und Zahlungsbedingung von Blistercentern; Chargen entsperren.</field>
    </record>

    <record id="group_bc_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_blistercenter"/>
        <field name="implied_ids" eval="[
            (4, ref('group_bc_approver')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('purchase.group_purchase_manager')),
        ]"/>
        <field name="comment">Zusätzlich: Einstellungen und Prozessregeln der App Blistercenter, Preislisten.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_bc_manager'))]"/>
    </record>
</odoo>
