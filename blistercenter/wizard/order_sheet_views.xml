<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bestellschein (1.4.0): Telefonbestellung aus einer festen Artikelliste, nur Mengen eintragen -->
    <record id="view_bc_order_sheet_form" model="ir.ui.view">
        <field name="name">blistercenter.order.sheet.form</field>
        <field name="model">blistercenter.order.sheet</field>
        <field name="arch" type="xml">
            <form string="Bestellschein">
                <div class="alert alert-danger" role="alert" invisible="not payment_block">
                    <b>Zahlungssperre:</b> <field name="payment_block_reason" class="oe_inline" readonly="1"/>.
                    Die Bestellung lässt sich anlegen, aber nicht bestätigen.
                </div>
                <group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}" placeholder="Blistercenter wählen"/>
                        <field name="orderer_id" options="{'no_create': True}" placeholder="Ansprechpartner"/>
                        <field name="orderer_name" placeholder="oder Name, falls nicht als Kontakt angelegt"/>
                    </group>
                    <group>
                        <field name="channel" widget="radio" options="{'horizontal': true}"/>
                        <field name="client_order_ref"/>
                        <field name="discount" invisible="not partner_id" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false" no_open="1">
                        <field name="sequence" column_invisible="1"/>
                        <field name="default_code" readonly="1"/>
                        <field name="product_id" column_invisible="1" readonly="1" force_save="1"/>
                        <field name="product_name" readonly="1"/>
                        <field name="price_hap" readonly="1"/>
                        <field name="price_customer" readonly="1"/>
                        <field name="qty" string="Menge" class="fw-bold"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="note" placeholder="z. B. Lieferwunsch"/>
                    </group>
                    <group>
                        <field name="total" readonly="1"/>
                    </group>
                </group>
                <p class="text-muted small">Preise netto ohne USt. Der Auftrag entsteht als Entwurf; danach „Bestätigen“ und „Proforma drucken“.</p>
                <footer>
                    <button name="action_create_order" type="object" string="Bestellung anlegen" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Abbrechen" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 1.4.0: Telefonbestellung = Bestellschein (feste Artikelliste, nur Mengen) -->
    <record id="action_bc_phone_order" model="ir.actions.act_window">
        <field name="name">Bestellschein</field>
        <field name="res_model">blistercenter.order.sheet</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="blistercenter.view_bc_order_sheet_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'large'}</field>
    </record>
</odoo>
