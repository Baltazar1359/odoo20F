<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Startseite „Meine Aufgaben“ (1.3.0): je Arbeitsbereich nur die eigenen Kacheln (Regel R41).
         Aktionen (z. B. Telefonbestellung) als großer Knopf oben, Aufgaben mit Anzahl darunter;
         Aufgaben ohne offene Vorgänge sind blass. -->
    <record id="view_bc_overview_kanban" model="ir.ui.view">
        <field name="name">blistercenter.overview.kanban</field>
        <field name="model">blistercenter.overview</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false" action="action_open" type="object"
                    class="o_bc_overview">
                <field name="key"/>
                <field name="kind"/>
                <field name="count"/>
                <templates>
                    <t t-name="card">
                        <div t-if="record.kind.raw_value === 'action'"
                             class="d-flex align-items-center justify-content-between bg-primary text-white rounded p-3 m-n2">
                            <div>
                                <field name="name" class="fw-bold fs-4"/>
                                <div class="small"><field name="description"/></div>
                            </div>
                            <span class="fs-2 fw-bold ms-3" aria-hidden="true">+</span>
                        </div>
                        <div t-else=""
                             t-attf-class="d-flex align-items-center justify-content-between #{record.count.raw_value ? '' : 'opacity-50'}">
                            <div>
                                <field name="name" class="fw-bold fs-5"/>
                                <div class="text-muted small"><field name="description"/></div>
                            </div>
                            <div t-attf-class="display-6 fw-bold ms-3 #{record.count.raw_value and ['payment_blocks', 'overdue_invoices', 'blocked_lots'].includes(record.key.raw_value) ? 'text-danger' : ''}">
                                <field name="count"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bc_overview" model="ir.actions.act_window">
        <field name="name">Meine Aufgaben</field>
        <field name="res_model">blistercenter.overview</field>
        <field name="view_mode">kanban</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_bc_overview_kanban')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Keine Aufgaben für Sie</p>
            <p>Ihnen ist noch kein Arbeitsbereich zugeordnet. Die Administration ordnet ihn unter
               Einstellungen › Benutzer zu: „Blistercenter: Bestellannahme“, „Einkauf“ oder „Lager“.</p>
        </field>
    </record>
</odoo>
