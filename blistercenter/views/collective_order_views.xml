<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bc_collective_form" model="ir.ui.view">
        <field name="name">blistercenter.collective.order.form</field>
        <field name="model">blistercenter.collective.order</field>
        <field name="arch" type="xml">
            <form string="Sammelbestellung">
                <header>
                    <button name="action_create_purchase" type="object" string="Anfrage beim Hersteller erstellen"
                            class="btn-primary" invisible="state != 'draft'"
                            confirm="Aus den Kundenmengen wird eine Anfrage beim Hersteller erstellt. Bestellt wird danach manuell im Einkauf. Fortfahren?"/>
                    <button name="action_open_purchase" type="object" string="Bestellung öffnen"
                            invisible="not purchase_id"/>
                    <button name="action_cancel" type="object" string="Stornieren"
                            invisible="state in ('cancel', 'done')"/>
                    <button name="action_set_draft" type="object" string="Zurück in Entwurf"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ordered,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="purchase_id"/>
                            <field name="purchase_state" invisible="not purchase_id"/>
                            <field name="receipt_status" invisible="not purchase_id"/>
                            <field name="customer_count"/>
                            <field name="product_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Kundenmengen">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sale_line_id" options="{'no_create': True}"/>
                                    <field name="sale_order_id"/>
                                    <field name="partner_id"/>
                                    <field name="product_id"/>
                                    <field name="qty_ordered_customer" optional="show"/>
                                    <field name="qty" sum="Summe"/>
                                    <field name="uom_id"/>
                                    <field name="purchase_line_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Notiz">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bc_collective_list" model="ir.ui.view">
        <field name="name">blistercenter.collective.order.list</field>
        <field name="model">blistercenter.collective.order</field>
        <field name="arch" type="xml">
            <list string="Sammelbestellungen" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="user_id" optional="show"/>
                <field name="customer_count"/>
                <field name="product_count"/>
                <field name="purchase_id"/>
                <field name="receipt_status" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'ordered'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_bc_collective_search" model="ir.ui.view">
        <field name="name">blistercenter.collective.order.search</field>
        <field name="model">blistercenter.collective.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="line_ids" string="Kunde" filter_domain="[('line_ids.partner_id', 'ilike', self)]"/>
                <field name="line_ids" string="Artikel" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="open" string="Offen" domain="[('state', 'in', ('draft', 'ordered'))]"/>
                <filter name="draft" string="Entwurf" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_supplier" string="Hersteller" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bc_collective_orders" model="ir.actions.act_window">
        <field name="name">Sammelbestellungen</field>
        <field name="res_model">blistercenter.collective.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Sammelbestellung</p>
            <p>Unter Kundenbestellungen › Positionen offene Kundenmengen markieren und „Zur Sammelbestellung“ wählen.</p>
        </field>
    </record>

    <!-- Herstellerbestellungen (Standard Einkauf) -->
    <record id="purchase_order_form_bc" model="ir.ui.view">
        <field name="name">purchase.order.form.blistercenter</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="bc_is_collective" invisible="1"/>
                <button name="action_bc_open_collective" type="object" class="oe_stat_button" icon="fa-cubes"
                        string="Sammelbestellung" invisible="not bc_is_collective" groups="blistercenter.group_bc_user"/>
            </div>
        </field>
    </record>

    <record id="action_bc_purchase_orders" model="ir.actions.act_window">
        <field name="name">Bestellungen beim Hersteller</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bc_is_collective', '=', True)]</field>
    </record>
</odoo>
