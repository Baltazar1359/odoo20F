<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_bc" model="ir.ui.view">
        <field name="name">website.form.blistercenter</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <group name="domain" position="after">
                <group name="blistercenter" string="Blistercenter">
                    <field name="bc_shop_restricted"/>
                    <div colspan="2" class="text-muted small">
                        Geschützter B2B-Shop: Artikel, Preise, Warenkorb und Bestellung nur für Portalbenutzer
                        freigeschalteter Blistercenter mit „Shop-Zugang (Benutzer)“. Besucher ohne Anmeldung werden zur
                        Anmeldung geleitet, andere angemeldete Benutzer erhalten „Zugriff verweigert“.
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
