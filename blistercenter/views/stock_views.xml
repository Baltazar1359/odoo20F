<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transfer-Formular: Blistercenter-Schritte -->
    <record id="view_picking_form_bc" model="ir.ui.view">
        <field name="name">stock.picking.form.blistercenter</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="bc_kind" invisible="1"/>
                <field name="bc_short_open" invisible="1"/>
                <field name="bc_can_release" invisible="1"/>
                <button name="action_bc_mark_picked" type="object" string="Kommissionierung abgeschlossen"
                        class="oe_highlight" groups="blistercenter.group_bc_user"
                        invisible="bc_kind != 'delivery' or bc_picked_by or state not in ('assigned', 'confirmed', 'waiting')"/>
                <button name="action_bc_scan" type="object" string="Scannen (DataMatrix)" class="oe_highlight"
                        groups="blistercenter.group_bc_user"
                        invisible="bc_kind != 'receipt' or state in ('done', 'cancel', 'draft')"/>
                <button name="action_bc_short_approve" type="object" string="Kurzläufer freigeben"
                        class="oe_highlight" groups="blistercenter.group_bc_approver"
                        invisible="not bc_short_open or state in ('done', 'cancel')"/>
            </header>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="bc_kind != 'release' or state in ('done', 'cancel')"
                     groups="blistercenter.group_bc_user">
                    Freigabe aus der Blistercenter-Quarantäne. Bestätigen darf nur die Rolle „Freigabe“ (VP),
                    nicht die Person, die den Wareneingang gebucht hat.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not bc_short_open or state in ('done', 'cancel')"
                     groups="blistercenter.group_bc_user">
                    Kurzläufer: <field name="bc_short_lot_ids" widget="many2many_tags" class="d-inline"/>.
                    Restlaufzeit unter der Grenze; die VP muss zusätzlich freigeben.
                </div>
                <field name="bc_lot_warning" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="not bc_lot_warning"
                     groups="blistercenter.group_bc_user">
                    <strong>Hinweis zu Chargen:</strong> <field name="bc_lot_warning" class="d-inline"/>
                    Das Buchen bleibt möglich; der Hinweis kommt in den Verlauf und die VP bekommt eine Aufgabe.
                </div>
                <field name="bc_overdue_count" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="bc_kind != 'delivery' or not bc_overdue_count or state in ('done', 'cancel')"
                     groups="blistercenter.group_bc_user">
                    Achtung: Der Kunde hat <field name="bc_overdue_count" class="d-inline fw-bold"/> überfällige
                    Rechnung(en) über <field name="bc_overdue_amount" class="d-inline fw-bold"/>.
                    Die Lieferung ist trotzdem möglich.
                </div>
                <div class="alert alert-info mb-0" role="alert"
                     invisible="bc_kind != 'delivery' or not bc_picked_by or state in ('done', 'cancel')"
                     groups="blistercenter.group_bc_user">
                    Kommissioniert von <field name="bc_picked_by" class="d-inline fw-bold"/>.
                    Die Endkontrolle und Bestätigung macht eine andere Person.
                </div>
            </xpath>
            <notebook position="inside">
                <page name="blistercenter" string="Blistercenter" invisible="not bc_kind" groups="blistercenter.group_bc_user">
                    <group>
                        <group string="Ablauf">
                            <field name="bc_kind" readonly="1"/>
                            <field name="bc_validated_by"/>
                            <field name="bc_validated_date"/>
                            <field name="bc_picked_by" invisible="bc_kind != 'delivery'"/>
                            <field name="bc_picked_date" invisible="bc_kind != 'delivery'"/>
                            <field name="bc_partial_allowed" invisible="bc_kind != 'delivery'"/>
                            <field name="bc_invoice_ids" widget="many2many_tags" invisible="bc_kind != 'delivery'"/>
                        </group>
                        <group string="Kurzläufer" invisible="bc_kind == 'receipt'">
                            <field name="bc_short_lot_ids" widget="many2many_tags"/>
                            <field name="bc_short_approved_lot_ids" widget="many2many_tags"/>
                            <field name="bc_short_approved_by"/>
                            <field name="bc_short_approved_date"/>
                            <field name="bc_short_reason"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_bc_picking_list" model="ir.ui.view">
        <field name="name">stock.picking.list.blistercenter</field>
        <field name="model">stock.picking</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Vorgänge" create="false" decoration-muted="state == 'cancel'" decoration-warning="bc_short_open">
                <field name="name"/>
                <field name="partner_id" string="Partner"/>
                <field name="origin" optional="show"/>
                <field name="scheduled_date" optional="show"/>
                <field name="bc_kind" optional="hide"/>
                <field name="bc_short_open" string="Kurzläufer offen" optional="show"/>
                <field name="bc_picked_by" optional="show"/>
                <field name="bc_validated_by" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_bc_receipts" model="ir.actions.act_window">
        <field name="name">Wareneingänge</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bc_kind', '=', 'receipt')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_picking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
        <field name="help" type="html">
            <p>Wareneingänge aus Sammelbestellungen. Die Ware kommt in die Quarantäne und wird danach von der VP freigegeben.</p>
        </field>
    </record>

    <record id="action_bc_release" model="ir.actions.act_window">
        <field name="name">Freigabe Wareneingang (VP)</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bc_kind', '=', 'release'), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_picking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
        <field name="help" type="html">
            <p>Ware in der Quarantäne, die auf die Freigabe der VP wartet.</p>
        </field>
    </record>

    <record id="action_bc_picking" model="ir.actions.act_window">
        <field name="name">Kommissionierung</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'not in', ('done', 'cancel', 'draft')), '|',
            '&amp;', ('bc_kind', '=', 'delivery'), ('bc_picked_by', '=', False),
            '&amp;', ('picking_type_code', '=', 'internal'), ('bc_is_blistercenter', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_picking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
        <field name="help" type="html">
            <p>Lieferungen an Blistercenter, die noch kommissioniert werden. Danach „Kommissionierung abgeschlossen“ melden.</p>
        </field>
    </record>

    <record id="action_bc_check" model="ir.actions.act_window">
        <field name="name">Endkontrolle</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bc_kind', '=', 'delivery'), ('bc_picked_by', '!=', False), ('state', 'not in', ('done', 'cancel'))]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_picking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
        <field name="help" type="html">
            <p>Kommissionierte Lieferungen. Eine zweite Person kontrolliert und bestätigt. Odoo prüft Zahlungssperre, Chargen, Kurzläufer und Teillieferung.</p>
        </field>
    </record>

    <record id="action_bc_deliveries" model="ir.actions.act_window">
        <field name="name">Lieferungen</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bc_kind', '=', 'delivery')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_picking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
    </record>

    <record id="action_bc_partial" model="ir.actions.act_window">
        <field name="name">Teillieferungen</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bc_kind', '=', 'delivery'), ('backorder_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_picking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')})]"/>
        <field name="help" type="html">
            <p>Restlieferungen aus erlaubten Teillieferungen.</p>
        </field>
    </record>

    <!-- Kurzläufer im Bestand -->
    <record id="view_bc_short_quant_list" model="ir.ui.view">
        <field name="name">stock.quant.list.blistercenter.short</field>
        <field name="model">stock.quant</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Kurzläufer im Bestand" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="lot_id" string="Charge"/>
                <field name="expiration_date" string="Verfall"/>
                <field name="location_id"/>
                <field name="quantity" sum="Summe"/>
                <field name="reserved_quantity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_bc_short_quants" model="ir.actions.act_window">
        <field name="name">Kurzläufer im Bestand</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('location_id.usage', '=', 'internal'), ('quantity', '&gt;', 0), ('lot_id.expiration_date', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_short_quant_list')})]"/>
    </record>

    <!-- Chargen: Sperre -->
    <record id="view_production_lot_form_bc" model="ir.ui.view">
        <field name="name">stock.lot.form.blistercenter</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <group name="main_group" position="after">
                <field name="bc_can_unblock" invisible="1"/>
                <group name="bc_block" string="Sperre" groups="blistercenter.group_bc_user">
                    <group>
                        <field name="bc_blocked" readonly="bc_blocked and not bc_can_unblock"/>
                        <field name="bc_block_reason" invisible="not bc_blocked" required="bc_blocked"
                               readonly="bc_blocked and not bc_can_unblock and bc_block_reason"/>
                    </group>
                    <group invisible="not bc_blocked">
                        <field name="bc_blocked_by"/>
                        <field name="bc_blocked_date"/>
                    </group>
                </group>
            </group>
            <div class="oe_title" position="before">
                <div class="alert alert-danger" role="alert" invisible="not bc_blocked">
                    Diese Charge ist gesperrt und darf nicht versendet werden.
                </div>
            </div>
        </field>
    </record>

    <record id="view_bc_lot_list" model="ir.ui.view">
        <field name="name">stock.lot.list.blistercenter</field>
        <field name="model">stock.lot</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Chargen" decoration-danger="bc_blocked">
                <field name="name" string="Charge"/>
                <field name="product_id"/>
                <field name="expiration_date" string="Verfall"/>
                <field name="product_qty" string="Bestand" optional="show"/>
                <field name="bc_blocked"/>
                <field name="bc_block_reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bc_lot_search" model="ir.ui.view">
        <field name="name">stock.lot.search.blistercenter</field>
        <field name="model">stock.lot</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="bc_blocked" string="Gesperrt" domain="[('bc_blocked', '=', True)]"/>
                <filter name="bc_in_stock" string="Mit Bestand" domain="[('product_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="bc_expired" string="Verfallen" domain="[('expiration_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="bc_expiry_6" string="Verfall in 6 Monaten"
                        domain="[('expiration_date', '&lt;', (context_today() + relativedelta(months=6)).strftime('%Y-%m-%d'))]"/>
                <filter name="bc_expiry_12" string="Verfall in 12 Monaten"
                        domain="[('expiration_date', '&lt;', (context_today() + relativedelta(months=12)).strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>

    <record id="action_bc_lots" model="ir.actions.act_window">
        <field name="name">Chargen</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bc_lot_search"/>
        <field name="context">{'search_default_bc_in_stock': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_lot_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_production_lot_form')})]"/>
    </record>

    <record id="action_bc_lots_expiry" model="ir.actions.act_window">
        <field name="name">Verfallsdaten</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bc_lot_search"/>
        <field name="domain">[('expiration_date', '!=', False)]</field>
        <field name="context">{'search_default_bc_in_stock': 1, 'search_default_bc_expiry_6': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_lot_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_production_lot_form')})]"/>
    </record>

    <record id="action_bc_lots_blocked" model="ir.actions.act_window">
        <field name="name">Gesperrte Chargen</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bc_lot_search"/>
        <field name="domain">[('bc_blocked', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_lot_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_production_lot_form')})]"/>
    </record>

    <record id="view_bc_recall_move_line_list" model="ir.ui.view">
        <field name="name">stock.move.line.list.blistercenter.recall</field>
        <field name="model">stock.move.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Gelieferte Mengen" create="false" edit="false" delete="false">
                <field name="date" string="Datum"/>
                <field name="picking_id" string="Lieferung"/>
                <field name="picking_partner_id" string="Kunde"/>
                <field name="product_id"/>
                <field name="lot_id" string="Charge"/>
                <field name="quantity" string="Menge" sum="Summe"/>
                <field name="uom_id" string="Einheit"/>
            </list>
        </field>
    </record>
</odoo>
