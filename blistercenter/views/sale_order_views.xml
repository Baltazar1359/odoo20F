<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kundenauftrag: Bestellweg, Status, Hinweise, Teillieferung -->
    <record id="view_order_form_bc" model="ir.ui.view">
        <field name="name">sale.order.form.blistercenter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_bc_print_proforma" type="object" string="Proforma drucken"
                        invisible="not bc_is_blistercenter or state != 'sale'"
                        groups="blistercenter.group_bc_user"/>
                <button name="action_bc_allow_partial" type="object" string="Teillieferung erlauben"
                        invisible="not bc_is_blistercenter or state != 'sale' or bc_partial_allowed"
                        groups="blistercenter.group_bc_user"/>
                <button name="action_bc_revoke_partial" type="object" string="Teillieferung zurücknehmen"
                        invisible="not bc_is_blistercenter or state != 'sale' or not bc_partial_allowed"
                        groups="blistercenter.group_bc_user"/>
            </header>
            <header position="after">
                <field name="bc_is_blistercenter" invisible="1"/>
                <field name="bc_payment_block" invisible="1"/>
                <field name="bc_shop_enabled" invisible="1"/>
                <field name="bc_overdue_count" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not bc_is_blistercenter or not bc_payment_block"
                     groups="blistercenter.group_bc_user">
                    Zahlungssperre: <field name="bc_payment_block_reason" class="fw-bold"/>.
                    Bestätigen, Bündeln und Versand sind gesperrt.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not bc_is_blistercenter or not bc_overdue_count or state == 'cancel'"
                     groups="blistercenter.group_bc_user">
                    Achtung: Der Kunde hat <field name="bc_overdue_count" class="d-inline fw-bold"/> überfällige
                    Rechnung(en) über <field name="bc_overdue_amount" class="d-inline fw-bold"/>.
                    Bestellung und Lieferung bleiben möglich.
                </div>
                <div class="alert alert-info mb-0" role="alert"
                     invisible="not bc_is_blistercenter or not bc_partial_allowed" groups="blistercenter.group_bc_user">
                    Teillieferung erlaubt: <field name="bc_partial_note" class="fw-bold"/>
                    (<field name="bc_partial_by" class="d-inline"/>, <field name="bc_partial_date" class="d-inline"/>)
                </div>
            </header>
            <div name="button_box" position="inside">
                <button name="action_bc_open_collective" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="not bc_collective_count" groups="blistercenter.group_bc_user">
                    <field name="bc_collective_count" widget="statinfo" string="Sammelbestellungen"/>
                </button>
            </div>
            <group name="partner_details" position="inside">
                <field name="bc_channel" invisible="not bc_is_blistercenter and not bc_channel"
                       readonly="state in ('sale', 'cancel')" groups="blistercenter.group_bc_user"/>
                <field name="bc_commercial_partner_id" invisible="1"/>
                <field name="bc_orderer_id" invisible="not bc_channel or bc_channel == 'shop'"
                       readonly="state in ('sale', 'cancel')" options="{'no_create': True}"
                       groups="blistercenter.group_bc_user"/>
                <field name="bc_orderer_name" invisible="not bc_channel or bc_channel == 'shop' or bc_orderer_id"
                       readonly="state in ('sale', 'cancel')" groups="blistercenter.group_bc_user"/>
                <field name="bc_received_by" invisible="not bc_channel or bc_channel == 'shop'" readonly="1"
                       groups="blistercenter.group_bc_user"/>
                <field name="bc_received_date" invisible="not bc_channel or bc_channel == 'shop'" readonly="1"
                       groups="blistercenter.group_bc_user"/>
            </group>
            <field name="payment_term_id" position="after">
                <field name="bc_state" widget="badge" invisible="not bc_is_blistercenter"
                       decoration-danger="bc_state == 'blocked'"
                       decoration-success="bc_state == 'done'" decoration-info="bc_state in ('ready', 'partial')"
                       groups="blistercenter.group_bc_user"/>
                <field name="bc_payment_model" invisible="not bc_is_blistercenter" groups="blistercenter.group_bc_user"/>
                <field name="bc_discount" invisible="not bc_is_blistercenter" groups="blistercenter.group_bc_user"/>
                <field name="bc_partial_allowed" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Telefonbestellung: eigenes Formular-Aktion mit Bestellweg Telefon -->
    <record id="action_bc_phone_order" model="ir.actions.act_window">
        <field name="name">Telefonbestellung</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale.view_order_form"/>
        <field name="target">current</field>
        <field name="context">{'default_bc_channel': 'phone'}</field>
    </record>

    <record id="view_bc_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.list.blistercenter</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Kundenbestellungen" create="true" decoration-muted="state == 'cancel'">
                <field name="name" string="Nummer"/>
                <field name="date_order" string="Datum"/>
                <field name="partner_id" string="Blistercenter"/>
                <field name="bc_channel" optional="show"/>
                <field name="website_id" string="Shop" optional="hide"/>
                <field name="state" optional="hide"/>
                <field name="bc_state" widget="badge"
                       decoration-danger="bc_state == 'blocked'"
                       decoration-success="bc_state == 'done'" decoration-info="bc_state in ('ready', 'partial')"/>
                <field name="bc_payment_model" optional="show"/>
                <field name="bc_discount" optional="show"/>
                <field name="payment_term_id" optional="show"/>
                <field name="amount_total" sum="Summe"/>
                <field name="invoice_status" optional="show"/>
                <field name="delivery_status" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bc_sale_order_search" model="ir.ui.view">
        <field name="name">sale.order.search.blistercenter</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="bc_new" string="Eingegangen" domain="['|', ('state', '=', 'sent'), '&amp;', ('state', '=', 'draft'), ('website_id', '=', False)]"/>
                <filter name="bc_confirmed" string="Bestätigt" domain="[('state', '=', 'sale')]"/>
                <filter name="bc_shop" string="Aus dem Shop" domain="[('bc_channel', '=', 'shop')]"/>
                <filter name="bc_phone" string="Telefon" domain="[('bc_channel', '=', 'phone')]"/>
                <filter name="bc_blocked" string="Zahlungssperre" domain="[('partner_id.commercial_partner_id.bc_payment_block', '=', True)]"/>
                <filter name="bc_to_deliver" string="Noch zu liefern" domain="[('state', '=', 'sale'), ('delivery_status', 'in', ('pending', 'started', 'partial'))]"/>
                <filter name="bc_to_invoice" string="Zu fakturieren" domain="[('invoice_status', '=', 'to invoice')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_bc_sale_orders" model="ir.actions.act_window">
        <field name="name">Kundenbestellungen</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('bc_is_blistercenter', '=', True)]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_bc_sale_order_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_sale_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sale.view_order_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Noch keine Bestellungen von Blistercentern</p>
            <p>Bestellungen kommen aus dem Shop oder werden hier erfasst. Kunde muss als Blistercenter gekennzeichnet sein.</p>
        </field>
    </record>

    <!-- Positionen: offene Kundenmengen bündeln -->
    <record id="view_bc_sale_line_list" model="ir.ui.view">
        <field name="name">sale.order.line.list.blistercenter</field>
        <field name="model">sale.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Auftragspositionen" create="false" edit="false" delete="false">
                <header>
                    <button name="action_bc_add_to_collective" type="object" string="Zur Sammelbestellung"
                            class="btn-primary"/>
                    <button name="action_bc_from_stock" type="object" string="Aus Lagerbestand liefern"
                            confirm="Die markierten Positionen werden aus freiem Lagerbestand geliefert, nicht über eine Sammelbestellung. Fortfahren?"/>
                </header>
                <field name="order_id" string="Auftrag"/>
                <field name="order_partner_id" string="Blistercenter"/>
                <field name="bc_supplier_id" optional="show"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Menge" sum="Summe"/>
                <field name="product_uom_id" string="Einheit" optional="show"/>
                <field name="bc_qty_allocated" sum="Summe"/>
                <field name="bc_qty_open" sum="Summe" decoration-warning="bc_qty_open &gt; 0"/>
                <field name="bc_from_stock" optional="show"/>
                <field name="qty_delivered" string="Geliefert" optional="show"/>
                <field name="qty_invoiced" string="Fakturiert" optional="show"/>
                <field name="price_subtotal" optional="hide"/>
                <field name="state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bc_sale_line_search" model="ir.ui.view">
        <field name="name">sale.order.line.search.blistercenter</field>
        <field name="model">sale.order.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="order_partner_id" string="Blistercenter"/>
                <field name="product_id"/>
                <field name="bc_supplier_id"/>
                <filter name="bc_open" string="Offen zu bündeln" domain="[('bc_qty_open', '&gt;', 0)]"/>
                <filter name="bc_allocated" string="In Sammelbestellung" domain="[('bc_qty_allocated', '&gt;', 0)]"/>
                <group>
                    <filter name="group_supplier" string="Hersteller" context="{'group_by': 'bc_supplier_id'}"/>
                    <filter name="group_product" string="Artikel" context="{'group_by': 'product_id'}"/>
                    <filter name="group_partner" string="Blistercenter" context="{'group_by': 'order_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bc_sale_lines" model="ir.actions.act_window">
        <field name="name">Positionen</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('bc_is_blistercenter', '=', True), ('state', '=', 'sale'), ('display_type', '=', False)]</field>
        <field name="context">{'search_default_bc_open': 1, 'search_default_group_supplier': 1, 'search_default_group_product': 1}</field>
        <field name="search_view_id" ref="view_bc_sale_line_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_bc_sale_line_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nichts zu bestellen</p>
            <p>Hier erscheinen Positionen bestätigter Blistercenter-Bestellungen, je Hersteller. PLCS entscheidet, wann bestellt wird:
               Positionen markieren und „Zur Sammelbestellung“ wählen. Odoo bestellt nie automatisch.</p>
        </field>
    </record>

    <!-- Rechnungen und Zahlungen (Standard Buchhaltung, nur gefiltert) -->
    <record id="action_bc_invoices" model="ir.actions.act_window">
        <field name="name">Rechnungen</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('commercial_partner_id.bc_is_customer', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>

    <record id="action_bc_payments" model="ir.actions.act_window">
        <field name="name">Zahlungen</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'customer'), ('partner_id.commercial_partner_id.bc_is_customer', '=', True)]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer'}</field>
    </record>
</odoo>
