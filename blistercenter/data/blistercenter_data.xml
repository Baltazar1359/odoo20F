<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_collective_order" model="ir.sequence">
            <field name="name">Blistercenter Sammelbestellung</field>
            <field name="code">blistercenter.collective.order</field>
            <field name="prefix">BCS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <record id="tile_new_orders" model="blistercenter.overview">
        <field name="key">new_orders</field>
        <field name="name">Neue Bestellungen</field>
        <field name="description">Eingegangen, noch nicht bestätigt</field>
        <field name="sequence">10</field>
    </record>
    <record id="tile_downpayments_to_post" model="blistercenter.overview">
        <field name="key">downpayments_to_post</field>
        <field name="name">Anzahlungsrechnungen zu buchen</field>
        <field name="description">Vorkasse: Entwurf, noch nicht gebucht und versendet</field>
        <field name="sequence">15</field>
    </record>
    <record id="tile_awaiting_payment" model="blistercenter.overview">
        <field name="key">awaiting_payment</field>
        <field name="name">Warten auf Zahlung</field>
        <field name="description">Vorkasse, noch nicht vollständig bezahlt</field>
        <field name="sequence">20</field>
    </record>
    <record id="tile_payment_blocks" model="blistercenter.overview">
        <field name="key">payment_blocks</field>
        <field name="name">Zahlungssperren</field>
        <field name="description">Blistercenter mit Zahlungssperre</field>
        <field name="sequence">30</field>
    </record>
    <record id="tile_to_procure" model="blistercenter.overview">
        <field name="key">to_procure</field>
        <field name="name">Offene Kundenmengen</field>
        <field name="description">Noch keiner Sammelbestellung zugeordnet</field>
        <field name="sequence">40</field>
    </record>
    <record id="tile_open_collective" model="blistercenter.overview">
        <field name="key">open_collective</field>
        <field name="name">Offene Sammelbestellungen</field>
        <field name="description">Entwurf oder Anfrage beim Hersteller</field>
        <field name="sequence">50</field>
    </record>
    <record id="tile_open_receipts" model="blistercenter.overview">
        <field name="key">open_receipts</field>
        <field name="name">Offene Wareneingänge</field>
        <field name="description">Aus Sammelbestellungen</field>
        <field name="sequence">60</field>
    </record>
    <record id="tile_to_release" model="blistercenter.overview">
        <field name="key">to_release</field>
        <field name="name">Freigabe Wareneingang (VP)</field>
        <field name="description">Ware in Quarantäne</field>
        <field name="sequence">65</field>
    </record>
    <record id="tile_open_deliveries" model="blistercenter.overview">
        <field name="key">open_deliveries</field>
        <field name="name">Offene Lieferungen</field>
        <field name="description">An Blistercenter, noch nicht versendet</field>
        <field name="sequence">70</field>
    </record>
    <record id="tile_to_check" model="blistercenter.overview">
        <field name="key">to_check</field>
        <field name="name">Endkontrolle offen</field>
        <field name="description">Kommissioniert, zweite Person bestätigt</field>
        <field name="sequence">75</field>
    </record>
    <record id="tile_short_dated" model="blistercenter.overview">
        <field name="key">short_dated</field>
        <field name="name">Kurzläufer im Bestand</field>
        <field name="description">Restlaufzeit unter der Grenze</field>
        <field name="sequence">78</field>
    </record>
    <record id="tile_blocked_lots" model="blistercenter.overview">
        <field name="key">blocked_lots</field>
        <field name="name">Gesperrte Chargen</field>
        <field name="description">Dürfen nicht versendet werden</field>
        <field name="sequence">80</field>
    </record>

    <!-- Quarantäne und Vorgangstypen anlegen (bei Installation und Update, idempotent) -->
    <function model="blistercenter.config" name="_setup_all"/>
</odoo>
