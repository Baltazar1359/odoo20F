<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_plcs_dashboard" model="res.groups.privilege">
        <field name="name">Geschäftsführungs-Dashboard</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_dashboard_user" model="res.groups">
        <field name="name">Lesen</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_plcs_dashboard"/>
        <field name="comment">Dashboard öffnen: operative Kennzahlen, Lager und Qualität/GDP. Jede Zahl nur mit den eigenen Leserechten.</field>
    </record>

    <record id="group_dashboard_finance" model="res.groups">
        <field name="name">Finanzen</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_plcs_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
        <field name="comment">Zusätzlich Umsatz, Auftragseingang, Auftragswert und Bestandswert.</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_dashboard_finance'))]"/>
    </record>
</odoo>
